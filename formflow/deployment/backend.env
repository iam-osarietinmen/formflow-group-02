NODE_ENV=production
PORT=5000

# Database
DATABASE_URL=postgresql://formflow:CHANGE_ME_STRONG_PASSWORD@database:5432/formflow

# Authentication
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Admin seed (optional)
ADMIN_NAME=FormFlow Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Azure Blob Storage (for receipts)
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCOUNT_KEY=CHANGE_ME_STORAGE_KEY
AZURE_STORAGE_CONTAINER_NAME=receipts

# Optional Azure OpenAI / other services
AZURE_ENDPOINT=
AZURE_API_KEY=